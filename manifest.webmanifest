{
  "name": "Kira",
  "short_name": "Kira",
  "description": "Simple personal finance tracker in ringgit.",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#F2F5F8",
